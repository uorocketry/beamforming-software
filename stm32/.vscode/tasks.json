{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "firmware: build",
      "type": "shell",
      "command": "make -C libopencm3 TARGETS=stm32/f0 && make -C app clean all",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "host tests",
      "type": "shell",
      "command": "make -C tests clean test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": ["$gcc"]
    }
  ]
}
